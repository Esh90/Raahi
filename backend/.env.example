# Copy to .env (never commit .env)
#   cp .env.example .env

# ---- ElevenLabs (Esha) ----
ELEVENLABS_API_KEY=
# the female voice used for ALL clips (Voice Library -> voice -> ID)
ELEVENLABS_VOICE_ID=
# optional: voices to compare with  python -m voice_assets.generate_clips --audition
AUDITION_VOICE_IDS=
# live fallback TTS model (eleven_v3 supports Urdu)
RAAHI_LIVE_TTS_MODEL=eleven_v3

# ---- Detector (Esha) ----
# exported fixed-class model (fast) or yoloe-26s-seg.pt (open-vocab, slow). Mac: models/raahi_yoloe_s_416.mlpackage
RAAHI_MODEL=models/raahi_yoloe_s_416.onnx
RAAHI_IMGSZ=416
# RAAHI_DEVICE=mps

# ---- Server (Member B) ----
RAAHI_HOST=0.0.0.0
RAAHI_PORT=8000

# 0 = real Depth Anything (default). 1 = synthetic depth + mock detections for CI / no weights
RAAHI_MOCK=0

# transformers | coreml | mock | auto
RAAHI_DEPTH_BACKEND=auto

# Optional path to Apple CoreML Depth Anything V2 Small .mlpackage
RAAHI_DEPTH_COREML=

# Focal length in pixels at streamed width 416. From tools/calibrate.py
RAAHI_FX=320
RAAHI_FY=320

# Depth input short side (266-392). Lower = faster.
RAAHI_DEPTH_SHORT_SIDE=336

# Tape scale. Leave 1.0 to use server/depth_scale.txt
RAAHI_DEPTH_SCALE=1.0
